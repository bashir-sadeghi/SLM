#!/bin/bash --login
########## SBATCH Lines for Resource Request ##########
 
#SBATCH --time=10:59:50             # limit of wall clock time - how long the job will run (same as -t)
#SBATCH --nodes=1                   # number of different nodes - could be an exact number or a range of nodes (same as -N)
#SBATCH --ntasks=1                  # number of tasks - how many tasks (nodes) that you require (same as -n)
#SBATCH --cpus-per-task=1           # number of CPUs (or cores) per task (same as -c)
#SBATCH --gpus=v100:1
#SBATCH --mem-per-cpu=32G            # memory required per allocated CPU (or core) - amount of memory (in bytes)
#SBATCH --job-name dpulsea    # you can give your job a name for easier identification (same as -J)
#SBATCH --output=./jobs_outputs/dpulsea.out    # output file to write the log to

########## Command Lines for Job Running ##########

# export PATH=$PATH:/mnt/research/SDAQ/sadeghib/miniconda3/bin

module purge
module load Conda/3
conda activate frib

cd /mnt/research/SDAQ/sadeghib/frib

echo python main.py --args exps/sean/saefit_asym.ini --manual-seed=1

date

srun python main.py --args exps/sean/saefit_asym.ini --manual-seed=1

date